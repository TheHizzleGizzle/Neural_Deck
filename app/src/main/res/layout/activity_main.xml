<?xml version="1.0" encoding="utf-8"?>
    <FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootWorkspace"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cyber_void">

    <!-- Pixel dot-grid & subtle scanline backdrop -->
    <com.example.wtfff.ui.PixelGridBackgroundView
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- TOP HUD BAR -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_px_panel"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="10dp"
            android:paddingEnd="12dp"
            android:paddingBottom="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Session Selector Trigger -->
                <LinearLayout
                    android:id="@+id/btnSessionPicker"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:padding="2dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:letterSpacing="0.1"
                        android:text="NEURAL//DECK_OS"
                        android:textColor="@color/neon_cyan"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:layout_marginEnd="6dp"
                            android:src="@drawable/ic_px_folder"
                            android:tint="@color/text_holo" />

                        <TextView
                            android:id="@+id/tvSessionTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:fontFamily="monospace"
                            android:maxLines="1"
                            android:text="AMBIENT_FOCUS_OS ▾"
                            android:textColor="@color/text_holo"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Graveyard Badge -->
                <LinearLayout
                    android:id="@+id/btnGraveyard"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_px_grave_badge"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp">

                    <ImageView
                        android:layout_width="13dp"
                        android:layout_height="13dp"
                        android:layout_marginEnd="4dp"
                        android:src="@drawable/ic_px_skull"
                        android:tint="@color/neon_crimson" />

                    <TextView
                        android:id="@+id/tvGraveCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:text="1"
                        android:textColor="@color/neon_crimson"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- BYOK Key Status Pill -->
                <LinearLayout
                    android:id="@+id/btnByokStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_px_chip_idle"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp">

                    <ImageView
                        android:id="@+id/ivByokIcon"
                        android:layout_width="13dp"
                        android:layout_height="13dp"
                        android:layout_marginEnd="4dp"
                        android:src="@drawable/ic_px_key"
                        android:tint="@color/neon_amber" />

                    <TextView
                        android:id="@+id/tvByokStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:text="BYOK"
                        android:textColor="@color/neon_amber"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Export Markdown Button -->
                <ImageButton
                    android:id="@+id/btnExportTree"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_px_chip_idle"
                    android:contentDescription="Export Markdown"
                    android:padding="6dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_px_export"
                    android:tint="@color/neon_cyan" />
            </LinearLayout>

            <!-- FILTER + SKILLS STUDIO STRIP -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tabFilterAll"
                    android:layout_width="wrap_content"
                    android:layout_height="26dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_px_chip_active"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="[ALL]"
                    android:textColor="@color/neon_cyan"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tabFilterStarred"
                    android:layout_width="wrap_content"
                    android:layout_height="26dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_px_chip_idle"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="[★ STARRED]"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tabFilterRoots"
                    android:layout_width="wrap_content"
                    android:layout_height="26dp"
                    android:background="@drawable/bg_px_chip_idle"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="[ROOTS]"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <LinearLayout
                    android:id="@+id/btnSkillsDeck"
                    android:layout_width="wrap_content"
                    android:layout_height="26dp"
                    android:background="@drawable/bg_px_chip_idle"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp">

                    <ImageView
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:layout_marginEnd="4dp"
                        android:src="@drawable/ic_px_chip"
                        android:tint="@color/neon_magenta" />

                    <TextView
                        android:id="@+id/tvActiveSkill"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:text="SKILL: 10X_DIVERGE"
                        android:textColor="@color/neon_magenta"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- AI ACTIVITY / LOADING TELEMETRY BAR -->
        <LinearLayout
            android:id="@+id/layoutLoadingBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1A00F0FF"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp"
            android:visibility="gone">

            <ProgressBar
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginEnd="8dp"
                android:indeterminateTint="@color/neon_cyan" />

            <TextView
                android:id="@+id/tvLoadingStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="monospace"
                android:text="SYNTHESIZING_NEURAL_BRANCHES..."
                android:textColor="@color/neon_cyan"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- MULTI-SELECT SPLICE / MASHUP ACTION BANNER -->
        <LinearLayout
            android:id="@+id/layoutMashupBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#29FF2E93"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginEnd="8dp"
                android:src="@drawable/ic_px_splice"
                android:tint="@color/neon_magenta" />

            <TextView
                android:id="@+id/tvMashupCount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="monospace"
                android:text="2 NODES ARMED FOR SPLICE"
                android:textColor="@color/text_holo"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnCancelMashup"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_px_chip_idle"
                android:fontFamily="monospace"
                android:gravity="center"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="CLEAR"
                android:textColor="@color/text_secondary"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnExecuteMashup"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:background="@drawable/bg_px_btn_magenta"
                android:fontFamily="monospace"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="SPLICE NODES"
                android:textColor="@color/neon_magenta"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- WORKSPACE CANVAS (BRANCHING IDEA CARTRIDGES) -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvIdeaTree"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingStart="10dp"
                android:paddingTop="10dp"
                android:paddingEnd="10dp"
                android:paddingBottom="18dp" />

            <!-- Empty State -->
            <LinearLayout
                android:id="@+id/layoutEmptyState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_margin="28dp"
                android:background="@drawable/bg_px_cartridge"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="22dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginBottom="10dp"
                    android:src="@drawable/ic_px_spark"
                    android:tint="@color/neon_cyan" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:text="@string/empty_deck_title"
                    android:textColor="@color/neon_cyan"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:lineSpacingExtra="3dp"
                    android:text="@string/empty_deck_sub"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>
        </FrameLayout>

        <!-- BOTTOM SEED TERMINAL & PROMPT LAB DOCK -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_px_panel"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingTop="8dp"
            android:paddingEnd="10dp"
            android:paddingBottom="10dp">

            <EditText
                android:id="@+id/etSeedPrompt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_px_terminal_input"
                android:fontFamily="sans-serif"
                android:gravity="top|start"
                android:hint="@string/seed_hint"
                android:inputType="textMultiLine|textCapSentences"
                android:maxLines="4"
                android:minLines="2"
                android:padding="10dp"
                android:textColor="@color/text_holo"
                android:textColorHint="@color/text_muted"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Prompt Lab / Optimize Button -->
                <LinearLayout
                    android:id="@+id/btnOptimizePrompt"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_px_btn_magenta"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginEnd="6dp"
                        android:src="@drawable/ic_px_spark"
                        android:tint="@color/neon_magenta" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:letterSpacing="0.06"
                        android:text="PROMPT_LAB"
                        android:textColor="@color/neon_magenta"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Spark Root Branches Button -->
                <LinearLayout
                    android:id="@+id/btnSparkIdeas"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1.15"
                    android:background="@drawable/bg_px_btn_cyan"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginEnd="6dp"
                        android:src="@drawable/ic_px_branch"
                        android:tint="@color/text_on_neon" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:letterSpacing="0.06"
                        android:text="SPARK_IDEAS"
                        android:textColor="@color/text_on_neon"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
