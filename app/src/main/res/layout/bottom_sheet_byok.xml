<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_px_panel"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginEnd="8dp"
                android:src="@drawable/ic_px_key"
                android:tint="@color/neon_cyan" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="monospace"
                android:letterSpacing="0.08"
                android:text="BYOK_VAULT // NEURAL_LINK"
                android:textColor="@color/neon_cyan"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Keys are AES-GCM hardware-encrypted inside Android Keystore on your device. Compatible with any OpenAI /chat/completions endpoint."
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <!-- Provider Preset Chips -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="monospace"
            android:text="[ PROVIDER_PRESET ]"
            android:textColor="@color/neon_cyan"
            android:textSize="10sp"
            android:textStyle="bold" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chipProvOpenRouter"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_px_chip_active"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="OPENROUTER"
                    android:textColor="@color/neon_cyan"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/chipProvOpenAi"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_px_chip_idle"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="OPENAI"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/chipProvGroq"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_px_chip_idle"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="GROQ"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/chipProvDeepSeek"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_px_chip_idle"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="DEEPSEEK"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/chipProvCustom"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:background="@drawable/bg_px_chip_idle"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="CUSTOM_URL"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Base URL -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="monospace"
            android:text="[ BASE_URL ]"
            android:textColor="@color/neon_cyan"
            android:textSize="10sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etBaseUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_px_terminal_input"
            android:fontFamily="monospace"
            android:hint="https://openrouter.ai/api/v1"
            android:inputType="textUri"
            android:padding="10dp"
            android:singleLine="true"
            android:textColor="@color/text_holo"
            android:textColorHint="@color/text_muted"
            android:textSize="12sp" />

        <!-- API Key -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="monospace"
            android:text="[ API_KEY (ENCRYPTED_ON_DEVICE) ]"
            android:textColor="@color/neon_cyan"
            android:textSize="10sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etApiKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_px_terminal_input"
            android:fontFamily="monospace"
            android:hint="sk-..."
            android:inputType="textPassword"
            android:padding="10dp"
            android:singleLine="true"
            android:textColor="@color/text_holo"
            android:textColorHint="@color/text_muted"
            android:textSize="12sp" />

        <!-- Model Name -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="monospace"
            android:text="[ MODEL_ID ]"
            android:textColor="@color/neon_cyan"
            android:textSize="10sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etModelId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_px_terminal_input"
            android:fontFamily="monospace"
            android:hint="openai/gpt-4o-mini"
            android:inputType="textNoSuggestions"
            android:padding="10dp"
            android:singleLine="true"
            android:textColor="@color/text_holo"
            android:textColorHint="@color/text_muted"
            android:textSize="12sp" />

        <!-- Creativity Temperature Slider -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="monospace"
                android:text="[ DIVERGENCE_TEMPERATURE ]"
                android:textColor="@color/neon_cyan"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvTempValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="0.85"
                android:textColor="@color/neon_magenta"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/seekTemperature"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:max="150"
            android:progress="85"
            android:progressTint="@color/neon_cyan"
            android:thumbTint="@color/neon_magenta" />

        <!-- Global Persona / Domain Context -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="monospace"
            android:text="[ OPTIONAL_GLOBAL_PERSONA / CONSTRAINTS ]"
            android:textColor="@color/neon_cyan"
            android:textSize="10sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etGlobalContext"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_px_terminal_input"
            android:hint="e.g. Solo indie Android dev, favor local-first privacy &amp; B2C subscriptions"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLines="3"
            android:minLines="2"
            android:padding="10dp"
            android:textColor="@color/text_holo"
            android:textColorHint="@color/text_muted"
            android:textSize="12sp" />

        <!-- Ping / Diagnostic Output -->
        <TextView
            android:id="@+id/tvPingResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_px_terminal_input"
            android:fontFamily="monospace"
            android:padding="8dp"
            android:text="STATUS: READY"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:visibility="gone" />

        <!-- Actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnPingConnection"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_px_btn_magenta"
                android:fontFamily="monospace"
                android:gravity="center"
                android:text="PING_ENDPOINT"
                android:textColor="@color/neon_magenta"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnSaveByok"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1.15"
                android:background="@drawable/bg_px_btn_cyan"
                android:fontFamily="monospace"
                android:gravity="center"
                android:text="LOCK_INTO_VAULT"
                android:textColor="@color/text_on_neon"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
