<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Hard 3dp pixel drop shadow -->
    <item
        android:left="3dp"
        android:top="3dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/cyber_shadow" />
            <stroke
                android:width="1dp"
                android:color="@color/cyber_border_dim" />
        </shape>
    </item>
    <!-- Main pixel cartridge body -->
    <item
        android:bottom="3dp"
        android:right="3dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/cyber_cartridge" />
            <stroke
                android:width="2dp"
                android:color="@color/cyber_border_bright" />
        </shape>
    </item>
</layer-list>
